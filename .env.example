# homedashboard environment variables.
# Copy to .env and adjust. Every value below is a generic default.
# No secrets, hostnames, usernames, or absolute host paths belong in this file.

# --- App (read by the dashboard at runtime) ---

# Interface the dashboard binds to.
DASHBOARD_HOST=0.0.0.0

# Port the dashboard listens on inside the container.
DASHBOARD_PORT=8080

# Poll interval in seconds for the JSON endpoint; 0 disables polling.
REFRESH_SECONDS=5

# Path to the Docker Engine unix socket (mounted read-only).
DOCKER_SOCKET=/var/run/docker.sock

# Docker Engine API version string sent to the daemon.
DOCKER_API_VERSION=v1.41

# Per-request timeout (seconds) for the Docker Engine API.
DOCKER_TIMEOUT_SECONDS=3

# Name or path of the herdr CLI binary.
HERDR_BIN=herdr

# Per-request timeout (seconds) for herdr CLI calls.
HERDR_TIMEOUT_SECONDS=3

# Herdr integration mode: embedded | external | off (defaults to embedded for any other value).
HERDR_MODE=embedded

# Host herdr config dir mounted into the container; empty means unset.
HERDR_CONFIG_DIR=

# Herdr Web UI URL. Empty means /herdr/ when HERDR_MODE=embedded (the container's own instance).
# A set HERDR_WEB_TOKEN forces the button to /herdr/ regardless of this value.
HERDR_WEB_URL=

# Bearer token for the herdr reverse proxy. Leave empty; the token is injected server-side, never in HTML/JS.
HERDR_WEB_TOKEN=

# Render the herdr Web UI inline in an iframe below the panels.
HERDR_WEB_EMBED=false

# Upstream URL the /herdr/ reverse proxy forwards to (loopback only).
HERDR_UPSTREAM=http://127.0.0.1:7317

# Address the bundled herdr Web UI binds to inside the container (entrypoint).
HERDR_WEB_BIND=127.0.0.1

# Port the bundled herdr Web UI listens on inside the container (entrypoint).
HERDR_WEB_PORT=7317

# Verify TLS certificates when the reverse proxy talks to HERDR_UPSTREAM.
HERDR_UPSTREAM_TLS_VERIFY=false

# Maximum response size (bytes) the /herdr/ reverse proxy will buffer.
HERDR_PROXY_MAX_BYTES=33554432

# Comma-separated process names treated as AI coding agents in the /proc fallback scan.
AGENT_PROCESS_PATTERNS=claude,opencode,pi,muse,codex,aider,gemini,hermes

# Path to the procfs root; tests inject a fake tree.
PROC_ROOT=/proc

# Mount point of the host root filesystem, mounted read-only for host disk stats.
HOST_ROOT=/host

# Comma-separated mount paths reported in the disk panel.
DISK_PATHS=/host,/host/home

# Window (seconds) between the two /proc/stat samples used for CPU utilisation.
CPU_SAMPLE_SECONDS=0.2

# CPU utilisation warning / critical thresholds (percent).
CPU_WARN=75
CPU_CRIT=90

# Memory warning / critical thresholds (percent).
MEM_WARN=75
MEM_CRIT=90

# Disk warning / critical thresholds (percent).
DISK_WARN=75
DISK_CRIT=90

# --- Compose-only (used by docker-compose.yml; the app does not read these) ---

# Host port published to DASHBOARD_PORT.
DASHBOARD_PUBLISH_PORT=8080

# Host path bind-mounted at HOST_ROOT (compose-only).
HOST_ROOT_SOURCE=/

# Host path bind-mounted at HERDR_CONFIG_DIR (compose-only); a bundled empty dir by default.
HERDR_CONFIG_SOURCE=./docker/empty-herdr
